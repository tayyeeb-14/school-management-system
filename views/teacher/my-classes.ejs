<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
        <h3 class="mb-1">My Classes</h3>
        <p class="text-muted mb-0">Classes assigned to you based on your timetable assignments.</p>
    </div>
</div>

<% if (classes && classes.length > 0) { %>
    <div class="row g-3">
        <% classes.forEach((cls) => { %>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm hover-shadow">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div>
                                <h5 class="card-title mb-1"><%= cls.name %></h5>
                                <p class="text-muted small mb-0">
                                    <% if (cls.section) { %>Section: <%= cls.section %><% } else { %>No section<% } %>
                                </p>
                            </div>
                            <span class="badge bg-primary"><%= cls.studentCount %> Students</span>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted">Class Information:</small>
                            <ul class="list-unstyled small mt-2">
                                <li class="mb-2">
                                    <i class="fas fa-users text-primary"></i>
                                    Total Students: <strong><%= cls.studentCount %></strong>
                                </li>
                                <% if (cls.totalStudents) { %>
                                    <li>
                                        <i class="fas fa-book text-success"></i>
                                        Standard Capacity: <strong><%= cls.totalStudents %></strong>
                                    </li>
                                <% } %>
                            </ul>
                        </div>

                        <a href="/teacher/students" class="btn btn-sm btn-outline-primary w-100">
                            <i class="fas fa-eye"></i> View Students
                        </a>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
<% } else { %>
    <div class="alert alert-info" role="alert">
        <i class="fas fa-info-circle"></i>
        <strong>No Classes Found</strong>
        <p class="mb-0 mt-2">You don't have any classes assigned yet. Please check your timetable assignments.</p>
    </div>
<% } %>

<style>
    .hover-shadow {
        transition: box-shadow 0.3s ease;
    }

    .hover-shadow:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .card-title {
        color: #333;
        font-weight: 600;
    }
</style>
