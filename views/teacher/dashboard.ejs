<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
        <h3 class="mb-1">Teacher Dashboard</h3>
        <p class="text-muted mb-0">
            Welcome, <strong><%= teacher.userId?.name || 'Teacher' %></strong>.
        </p>
    </div>
    <div class="text-muted">
        Subjects: <strong><%= (teacher.subjects || []).length ? (teacher.subjects || []).join(', ') : 'N/A' %></strong>
    </div>
</div>

<script src="/js/teacher-shift.js"></script>

<!-- Check In / Out Status for Today -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body text-center">
                <h6 class="card-title text-muted mb-2">Check In Status</h6>
                <% if (hasCheckedIn) { %>
                    <div class="badge bg-success mb-2">
                        <i class="fas fa-check-circle"></i> Checked In
                    </div>
                    <p class="small text-muted mb-0">
                        <%= todayShift?.checkInAt ? new Date(todayShift.checkInAt).toLocaleTimeString() : 'N/A' %>
                    </p>
                <% } else { %>
                    <div class="badge bg-warning text-dark mb-2">
                        <i class="fas fa-clock"></i> Not Checked In
                    </div>
                    <p class="small text-muted mb-2">Click Check In below to start</p>
                    <a href="/teacher/check-shift" class="btn btn-sm btn-outline-primary">Check In Now</a>
                <% } %>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body text-center">
                <h6 class="card-title text-muted mb-2">Check Out Status</h6>
                <% if (hasCheckedOut) { %>
                    <div class="badge bg-secondary mb-2">
                        <i class="fas fa-check-double"></i> Checked Out
                    </div>
                    <p class="small text-muted mb-0">
                        <%= todayShift?.checkOutAt ? new Date(todayShift.checkOutAt).toLocaleTimeString() : 'N/A' %>
                    </p>
                <% } else if (hasCheckedIn) { %>
                    <div class="badge bg-warning text-dark mb-2">
                        <i class="fas fa-hourglass-end"></i> Pending
                    </div>
                    <p class="small text-muted mb-2">Click Check Out to end shift</p>
                    <a href="/teacher/check-shift" class="btn btn-sm btn-outline-danger">Check Out Now</a>
                <% } else { %>
                    <div class="badge bg-secondary mb-2">
                        <i class="fas fa-ban"></i> Unavailable
                    </div>
                    <p class="small text-muted mb-0">Check in first</p>
                <% } %>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card bg-info text-white h-100">
            <div class="card-body text-center">
                <small class="text-white-50 d-block mb-1">Today's Classes</small>
                <h4 class="mb-0"><%= todayTimetable?.length || 0 %></h4>
                <small class="d-block mt-2"><%= todayDayName %></small>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card bg-primary text-white h-100">
            <div class="card-body text-center">
                <small class="text-white-50 d-block mb-1">View Full Schedule</small>
                <a href="/teacher/timetable" class="btn btn-sm btn-light mt-2">
                    <i class="fas fa-clock"></i> My Timetable
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Today's Timetable -->
<% if (todayTimetable && todayTimetable.length > 0) { %>
    <div class="card mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="fas fa-calendar-alt"></i> Today's Classes - <%= todayDayName %>
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th>Time</th>
                            <th>Class</th>
                            <th>Subject</th>
                            <th>Room</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% todayTimetable.forEach((slot) => { %>
                            <tr>
                                <td>
                                    <span class="badge bg-info">Period <%= slot.period %></span>
                                </td>
                                <td><strong><%= slot.time || '-' %></strong></td>
                                <td><strong><%= slot.classId?.name || '-' %></strong></td>
                                <td><%= slot.subject || '-' %></td>
                                <td><%= slot.room || '-' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
<% } %>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card bg-primary text-white h-100">
            <div class="card-body text-center">
                <small class="text-white-50 d-block mb-1">Assigned Classes</small>
                <h4 class="mb-0"><%= stats.classes %></h4>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card bg-success text-white h-100">
            <div class="card-body text-center">
                <small class="text-white-50 d-block mb-1">Students</small>
                <h4 class="mb-0"><%= stats.students %></h4>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card bg-warning text-dark h-100">
            <div class="card-body text-center">
                <small class="text-muted d-block mb-1">Attendance Marked Today</small>
                <h4 class="mb-0"><%= stats.attendanceMarkedToday %></h4>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card bg-danger text-white h-100">
            <div class="card-body text-center">
                <small class="text-white-50 d-block mb-1">Marks Pending</small>
                <h4 class="mb-0"><%= stats.marksPendingStudents %></h4>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-md-4">
                        <a href="/teacher/timetable" class="btn btn-outline-primary w-100">
                            <i class="fas fa-clock"></i> My Timetable
                        </a>
                    </div>
                    <div class="col-6 col-md-4">
                        <a href="/teacher/my-classes" class="btn btn-outline-info w-100">
                            <i class="fas fa-book"></i> My Classes
                        </a>
                    </div>
                    <div class="col-6 col-md-4">
                        <a href="/teacher/students" class="btn btn-outline-secondary w-100">
                            <i class="fas fa-user-graduate"></i> Students
                        </a>
                    </div>
                    <div class="col-6 col-md-4">
                        <a href="/teacher/marks" class="btn btn-outline-success w-100">
                            <i class="fas fa-pen"></i> Enter Marks
                        </a>
                    </div>
                    <div class="col-6 col-md-4">
                        <a href="/teacher/salary" class="btn btn-outline-dark w-100">
                            <i class="fas fa-wallet"></i> My Salary
                        </a>
                    </div>
                    <div class="col-6 col-md-4">
                        <a href="/teacher/profile" class="btn btn-outline-purple w-100">
                            <i class="fas fa-user-circle"></i> Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Current Month Salary</h5>
            </div>
            <div class="card-body">
                <div class="mb-2">Month: <strong><%= currentSalary.month %></strong></div>
                <div class="mb-2">Base: <strong>₹ <%= Number(currentSalary.baseSalary || 0).toFixed(2) %></strong></div>
                <div class="mb-2 text-success">Paid: <strong>₹ <%= Number(currentSalary.paidAmount || 0).toFixed(2) %></strong></div>
                <div class="mb-3 text-danger">Remaining: <strong>₹ <%= Number(currentSalary.remainingAmount || 0).toFixed(2) %></strong></div>
                <a href="/teacher/salary?month=<%= currentSalary.month %>" class="btn btn-sm btn-primary">View Salary Details</a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Shifts -->
<div class="card mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">Recent Shifts (Last 5 Days)</h5>
    </div>
    <div class="card-body p-0">
        <% if (recentShifts && recentShifts.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentShifts.forEach((s) => { %>
                            <tr>
                                <td><%= moment(s.date).format('DD MMM, YYYY') %></td>
                                <td><%= s.checkInAt ? moment(s.checkInAt).format('HH:mm') : '-' %></td>
                                <td><%= s.checkOutAt ? moment(s.checkOutAt).format('HH:mm') : '-' %></td>
                                <td><%= s.durationMinutes ? Math.floor(s.durationMinutes / 60) + 'h ' + (s.durationMinutes % 60) + 'm' : '-' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="p-3 text-muted">No shift records found.</div>
        <% } %>
    </div>
</div>

<!-- Recent Attendance Records -->
<div class="card">
    <div class="card-header bg-white">
        <h5 class="mb-0">Recent Attendance Records (Last 5)</h5>
    </div>
    <div class="card-body p-0">
        <% if (recentAttendance && recentAttendance.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Class</th>
                            <th>Total Students</th>
                            <th>Present</th>
                            <th>Absent</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentAttendance.forEach((record) => { %>
                            <% const total = record.entries.length; %>
                            <% const present = record.entries.filter((entry) => entry.status === 'present').length; %>
                            <% const absent = total - present; %>
                            <tr>
                                <td><%= moment(record.date).format('DD MMM, YYYY') %></td>
                                <td><%= record.classId?.name || '-' %></td>
                                <td><%= total %></td>
                                <td><span class="badge bg-success"><%= present %></span></td>
                                <td><span class="badge bg-danger"><%= absent %></span></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="p-3 text-muted">No attendance records yet.</div>
        <% } %>
    </div>
</div>
