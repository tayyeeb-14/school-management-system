<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div>
        <h3 class="mb-1">Class Management</h3>
        <p class="text-muted mb-0">Manage the centralized class list used throughout the application.</p>
    </div>
    <a href="/admin/classes/fees" class="btn btn-outline-primary">Manage Class Fees</a>
</div>

<div class="card mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">Add Class</h5>
    </div>
    <div class="card-body">
        <form action="/admin/classes" method="POST" class="row g-3 align-items-end">
            <div class="col-md-8">
                <label class="form-label">Class Name</label>
                <input type="text" name="name" class="form-control" required>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary">Add Class</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Class Name</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (classes && classes.length > 0) { %>
                        <% classes.forEach((classItem) => { %>
                            <tr>
                                <td><%= classItem.order %></td>
                                <td>
                                    <form action="/admin/classes/<%= classItem._id %>" method="POST" class="d-flex gap-2">
                                        <input type="hidden" name="_method" value="PUT">
                                        <input type="text" name="name" class="form-control form-control-sm" value="<%= classItem.name %>" required>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Rename</button>
                                    </form>
                                </td>
                                <td>
                                    <span class="badge <%= classItem.active ? 'bg-success' : 'bg-secondary' %>">
                                        <%= classItem.active ? 'Active' : 'Inactive' %>
                                    </span>
                                </td>
                                <td>
                                    <form action="/admin/classes/<%= classItem._id %>/toggle-active" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm <%= classItem.active ? 'btn-outline-danger' : 'btn-outline-success' %>">
                                            <%= classItem.active ? 'Deactivate' : 'Activate' %>
                                        </button>
                                    </form>
                                    <a href="/admin/classes/<%= classItem._id %>/fees/edit" class="btn btn-sm btn-outline-secondary">Fees</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="4" class="text-center text-muted p-4">No classes found.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
